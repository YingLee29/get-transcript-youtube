{
  "manifest_version": 3,
  "name": "YouTube → Văn bản (Tiếng Việt)",
  "version": "1.0.0",
  "description": "Chuyển lời nói trong video YouTube và Shorts thành văn bản. Có phụ đề sẵn hoặc dùng AI Whisper.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube → Văn bản",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
